        <PAGEOBJECT XPOS="148.189606299213" YPOS="8335.27275590551" OwnPage="25" ItemID="190584464" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="148.189606299213" gYpos="8335.27275590551" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="190612784" BACKITEM="190604288"/>
        <PAGEOBJECT XPOS="581.890393700788" YPOS="8335.27275590551" OwnPage="26" ItemID="190612784" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="581.890393700788" gYpos="8335.27275590551" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="190587296" BACKITEM="190584464"/>
        <PAGEOBJECT XPOS="148.189606299213" YPOS="8970.54803149606" OwnPage="27" ItemID="190587296" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="148.189606299213" gYpos="8970.54803149606" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="190615616" BACKITEM="190612784"/>
        <PAGEOBJECT XPOS="581.890393700788" YPOS="8970.54803149606" OwnPage="28" ItemID="190615616" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="581.890393700788" gYpos="8970.54803149606" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="190618448" BACKITEM="190587296"/>
        <PAGEOBJECT XPOS="148.189606299213" YPOS="9605.82330708661" OwnPage="29" ItemID="190618448" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="148.189606299213" gYpos="9605.82330708661" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="190592960" BACKITEM="190615616"/>
        <PAGEOBJECT XPOS="581.890393700788" YPOS="9605.82330708661" OwnPage="30" ItemID="190592960" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="581.890393700788" gYpos="9605.82330708661" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="190638272" BACKITEM="190618448"/>
        <PAGEOBJECT XPOS="148.189606299213" YPOS="10241.0985826772" OwnPage="31" ItemID="190638272" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="148.189606299213" gYpos="10241.0985826772" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="190632608" BACKITEM="190592960"/>
