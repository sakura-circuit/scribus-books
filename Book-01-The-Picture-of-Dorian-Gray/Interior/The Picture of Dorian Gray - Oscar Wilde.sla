        <MASTEROBJECT XPOS="148.189606299213" YPOS="553.593096577214" OwnPage="2" ItemID="177975680" PTYPE="4" WIDTH="308.790615458782" HEIGHT="16.530612244898" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.791 0 L308.791 16.5306 L0 16.5306 L0 0 Z" copath="M0 0 L308.791 0 L308.791 16.5306 L0 16.5306 L0 0 Z" OnMasterPage="Left Master Page" gXpos="226693.071496066" gYpos="597414764.584006" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
