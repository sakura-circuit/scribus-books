        <PAGEOBJECT XPOS="581.890393700788" YPOS="20405.502992126" OwnPage="64" ItemID="229051568" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="581.890393700788" gYpos="20405.502992126" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="229045904" BACKITEM="229040240"/>
        <PAGEOBJECT XPOS="148.189606299213" YPOS="21040.7782677165" OwnPage="65" ItemID="229045904" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="148.189606299213" gYpos="21040.7782677165" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="229062896" BACKITEM="229051568"/>
