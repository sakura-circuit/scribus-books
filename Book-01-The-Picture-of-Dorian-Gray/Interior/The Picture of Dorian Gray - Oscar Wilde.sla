        <PAGEOBJECT XPOS="581.890393700788" YPOS="5158.89637795275" OwnPage="16" ItemID="199772688" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="581.890393700788" gYpos="1982.51842519685" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="199775504" BACKITEM="178966160"/>
        <PAGEOBJECT XPOS="148.189606299213" YPOS="5794.1716535433" OwnPage="17" ItemID="199775504" PTYPE="4" WIDTH="308.976377952756" HEIGHT="476.220472440945" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" copath="M0 0 L308.976 0 L308.976 476.22 L0 476.22 L0 0 Z" gXpos="567.717165354331" gYpos="1982.51811023622" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="5497424" BACKITEM="199772688"/>
